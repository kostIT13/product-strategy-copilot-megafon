# Application
APP_ENV=development
LOG_LEVEL=INFO
PROJECTS_DIR=./projects

# Optional model helper; the IDE-native CLI does not require an API key.
# OpenAI-compatible provider; use the exact model ID served by this endpoint.
LLM_BASE_URL=https://provider.example/v1
LLM_MODEL=Qwen3.8-27B
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=2048
# Full strategy_options JSON may exceed 2048; choose the output limit explicitly before a new pipeline.
LLM_TIMEOUT_SECONDS=60
# Optional provider-specific JSON body, e.g. {"chat_template_kwargs":{"enable_thinking":false}}
LLM_EXTRA_BODY={}
