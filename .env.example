# Application
APP_ENV=development
LOG_LEVEL=INFO
PROJECTS_DIR=./projects

# PostgreSQL (local Docker Compose defaults; replace before shared deployment)
POSTGRES_DB=product_strategy
POSTGRES_USER=product_strategy
POSTGRES_PASSWORD=local-dev-change-this
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Local Python process connects through the published port; Compose overrides this URL.
DATABASE_URL=postgresql+psycopg://product_strategy:local-dev-change-this@127.0.0.1:5432/product_strategy

# OpenAI-compatible provider; use the exact model ID served by this endpoint.
LLM_BASE_URL=https://provider.example/v1
LLM_MODEL=qwen3.8:27b
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
# Optional provider-specific JSON body, e.g. {"chat_template_kwargs":{"enable_thinking":false}}
LLM_EXTRA_BODY={}
