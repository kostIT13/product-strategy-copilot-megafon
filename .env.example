# Application
APP_ENV=development
LOG_LEVEL=INFO
PROJECTS_DIR=./projects

# PostgreSQL (local Docker Compose defaults; replace before shared deployment)
POSTGRES_DB=product_strategy
POSTGRES_USER=product_strategy
POSTGRES_PASSWORD=local-dev-change-this
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://product_strategy:local-dev-change-this@postgres:5432/product_strategy

# Qwen-compatible API. Leave the key empty until API integration is enabled.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8:27b
QWEN_API_KEY=
